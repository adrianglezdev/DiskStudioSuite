<UserControl x:Class="DiskStudio.Views.DisksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskStudio.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,36">
            <!-- Cabecera -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Discos" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" Text="Buscando discos…"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Tag="&#xE72C;" Content="Actualizar" Click="OnRefresh"/>
                </StackPanel>
            </Grid>

            <!-- Aviso de administrador -->
            <Border x:Name="AdminBar" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16"
                    BorderBrush="{StaticResource InfoBrush}" Background="#1A20876C">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource InfoBrush}" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Funciones avanzadas desactivadas" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Ejecuta Disk Studio Suite como administrador para ver temperatura, horas de uso y atributos SMART, y para crear imágenes, clonar discos sector a sector, analizar la superficie o formatear."/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Tag="&#xE7EF;" Content="Reiniciar como administrador" Margin="16,0,0,0" Click="OnAdmin"/>
                </Grid>
            </Border>

            <!-- Resumen -->
            <UniformGrid x:Name="Summary" Rows="1" Margin="0,0,0,24">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" Foreground="White"/></Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="Discos físicos" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="StatDisks" Text="—" Style="{StaticResource BigNumber}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconTile}" Background="{StaticResource BrandSlateBrush}"><TextBlock Text="&#xEB05;" Style="{StaticResource Icon}" Foreground="White"/></Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="Capacidad total" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="StatCapacity" Text="—" Style="{StaticResource BigNumber}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconTile}" Background="{StaticResource BrandBrush2}"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="White"/></Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="Espacio libre" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="StatFree" Text="—" Style="{StaticResource BigNumber}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="StatHealthTile" Style="{StaticResource IconTile}" Background="#16A34A"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="White"/></Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="Estado de salud" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="StatHealth" Text="—" Style="{StaticResource BigNumber}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel x:Name="DiskList"/>

            <TextBlock x:Name="OtherTitle" Text="Otras unidades" Style="{StaticResource SectionTitle}" Margin="0,12,0,10" Visibility="Collapsed"/>
            <StackPanel x:Name="OtherList"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

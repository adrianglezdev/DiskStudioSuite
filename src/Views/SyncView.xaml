<UserControl x:Class="DiskStudio.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="36,28,36,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Sincronizar y comparar" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Compara dos carpetas, revisa las diferencias y aplica solo los cambios necesarios."/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Origen" Style="{StaticResource Label}"/>
                        <Grid>
                            <TextBox x:Name="LeftBox" Margin="0,0,44,0"/>
                            <Button Style="{StaticResource IconButton}" Tag="&#xE838;" HorizontalAlignment="Right" ToolTip="Elegir carpeta" Click="OnPickLeft"/>
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Tag="&#xE8AB;" ToolTip="Intercambiar" VerticalAlignment="Bottom" Margin="10,0" Click="OnSwap"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Destino" Style="{StaticResource Label}"/>
                        <Grid>
                            <TextBox x:Name="RightBox" Margin="0,0,44,0"/>
                            <Button Style="{StaticResource IconButton}" Tag="&#xE838;" HorizontalAlignment="Right" ToolTip="Elegir carpeta" Click="OnPickRight"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,16,0,0" VerticalAlignment="Center">
                    <Border CornerRadius="8" Padding="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,16,8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeUpdate" Style="{StaticResource SegmentItem}" Tag="&#xE72A;" Content="Actualizar" IsChecked="True" GroupName="mode" Checked="OnMode"
                                         ToolTip="Copia lo nuevo y lo modificado del origen al destino. No borra nada."/>
                            <RadioButton x:Name="ModeMirror" Style="{StaticResource SegmentItem}" Tag="&#xE7C4;" Content="Espejo" GroupName="mode" Checked="OnMode"
                                         ToolTip="Deja el destino idéntico al origen: copia cambios y BORRA lo que sobra en el destino."/>
                            <RadioButton x:Name="ModeTwoWay" Style="{StaticResource SegmentItem}" Tag="&#xE895;" Content="Bidireccional" GroupName="mode" Checked="OnMode"
                                         ToolTip="Copia en ambos sentidos: gana la versión más reciente. No borra nada."/>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="ByContent" Content="Comparar contenido (hash)" Margin="0,0,16,8" ToolTip="Más lento, pero detecta archivos con igual fecha y tamaño pero distinto contenido"/>
                    <CheckBox x:Name="VerifyBox" Content="Verificar al copiar" Margin="0,0,16,8"/>
                    <CheckBox x:Name="HiddenBox" Content="Incluir ocultos" IsChecked="True" Margin="0,0,16,8"/>
                </WrapPanel>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Incluir solo (ej. *.jpg; *.docx)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="IncludeBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Excluir (ej. node_modules; *.tmp; Thumbs.db)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="ExcludeBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Tag="&#xF0E3;" Content="Guardar como tarea" Click="OnSaveTask" Margin="0,0,8,0"/>
                        <Button x:Name="CompareBtn" Style="{StaticResource PrimaryButton}" Tag="&#xE9D5;" Content="Comparar" Click="OnCompare"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Resumen + acción -->
        <Border DockPanel.Dock="Bottom" x:Name="ApplyBar" Style="{StaticResource Card}" Padding="16,12" Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="PlanText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="ShowSame" Content="Mostrar idénticos" Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnShowSame" Unchecked="OnShowSame"/>
                    <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryButton}" Tag="&#xE895;" Content="Sincronizar ahora" Click="OnApply"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="Results" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                          SelectionMode="Extended" Background="Transparent" BorderThickness="0" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                        <DataGridTextColumn Header="Ruta" Binding="{Binding RelPath}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="150" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Origen" Binding="{Binding LeftSizeText}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Modificado" Binding="{Binding LeftTimeText}" Width="115" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="Acción" Width="150" SortMemberPath="ActionText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ActionGlyph}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Destino" Binding="{Binding RightSizeText}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Modificado" Binding="{Binding RightTimeText}" Width="115" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock x:Name="PlaceholderText" Text="Elige dos carpetas y pulsa Comparar" Margin="0,12,0,0" Style="{StaticResource Caption}" FontSize="14" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="240" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>

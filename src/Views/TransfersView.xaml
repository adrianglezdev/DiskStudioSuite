<UserControl x:Class="DiskStudio.Views.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskStudio.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <DockPanel Margin="36,28,36,24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Transferencias" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" Text="Cola de copias, movimientos, clonados e imágenes"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Tag="&#xE768;" Content="Reanudar todo" Click="OnResumeAll" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SecondaryButton}" Tag="&#xE769;" Content="Pausar todo" Click="OnPauseAll" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SecondaryButton}" Tag="&#xE74D;" Content="Limpiar terminados" Click="OnClear"/>
            </StackPanel>
        </Grid>

        <!-- Opciones de cola -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Límite de velocidad" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Slider x:Name="LimitSlider" Width="180" Minimum="0" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnLimit"/>
                <TextBlock x:Name="LimitText" Width="90" Margin="10,0,24,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Al terminar la cola" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ComboBox x:Name="AfterBox" Width="170" SelectionChanged="OnAfter">
                    <ComboBoxItem Content="No hacer nada"/>
                    <ComboBoxItem Content="Suspender el equipo"/>
                    <ComboBoxItem Content="Apagar el equipo"/>
                </ComboBox>
            </WrapPanel>
        </Border>

        <Grid>
            <!-- Estado vacío -->
            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80">
                <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource BrandGradient}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="32" Foreground="White"/>
                </Border>
                <TextBlock Text="No hay transferencias" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380"
                           Text="Copia o mueve archivos desde el Explorador (F5/F6 o arrastrando), sincroniza carpetas o clona discos y aparecerán aquí."/>
                <Button Style="{StaticResource PrimaryButton}" Tag="&#xE8B7;" Content="Ir al Explorador" HorizontalAlignment="Center" Margin="0,16,0,0" Click="OnGoExplorer"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="White" FontSize="18"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" MaxWidth="620"/>
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource ChipText}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,10"/>
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="6" IsIndeterminate="{Binding Indeterminate}"
                                                     Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Stats}" Style="{StaticResource Caption}" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" Opacity="0.8"/>
                                        <TextBlock Text="{Binding Result}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   Visibility="{Binding IsFinished, Converter={StaticResource BoolVis}}"/>
                                        <v:SpeedGraph Height="56" Margin="0,10,0,0" Visibility="{Binding CanPause, Converter={StaticResource BoolVis}}"/>
                                        <Expander Header="Errores" Margin="0,8,0,0" Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}">
                                            <ItemsControl ItemsSource="{Binding Errors}" MaxHeight="180">
                                                <ItemsControl.Template>
                                                    <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,2" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <Run Text="{Binding Path, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/> — <Run Text="{Binding Error, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource IconButton}" Tag="&#xE769;" ToolTip="Pausar" Click="OnPause" Visibility="{Binding CanPause, Converter={StaticResource BoolVis}}"/>
                                        <Button Style="{StaticResource IconButton}" Tag="&#xE768;" ToolTip="Reanudar" Click="OnResume" Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}"/>
                                        <Button Style="{StaticResource IconButton}" Tag="&#xE72C;" ToolTip="Reintentar los fallidos" Click="OnRetry" Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}"/>
                                        <Button Style="{StaticResource IconButton}" Tag="&#xE711;" ToolTip="Cancelar" Click="OnCancel" Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                        <Button Style="{StaticResource IconButton}" Tag="&#xE74D;" ToolTip="Quitar de la lista" Click="OnRemove" Visibility="{Binding IsFinished, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
